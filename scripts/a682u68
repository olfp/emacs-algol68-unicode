#!/usr/bin/env python3
import sys
import argparse
import re

def build_dynamic_maps():
    """Generiert die Unicode-Mappings fehlerfrei über die exakten Codepoints."""
    bold_map = {}
    italic_map = {}

    # 1. BOLD_MAP für Keywords (Ausgabe ist IMMER fett und klein: 𝐚-𝐳)
    for i in range(26):
        bold_map[chr(ord('a') + i)] = chr(0x1D41A + i)
        bold_map[chr(ord('A') + i)] = chr(0x1D41A + i)  # Fallback
    for i in range(10):
        bold_map[chr(ord('0') + i)] = chr(0x1D7CE + i)

    # 2. ITALIC_MAP für Bezeichner/Variablen (fall-sensitive für Groß/Klein)
    for i in range(26):
        if chr(ord('a') + i) == 'h':
            italic_map['h'] = chr(0x210E)  # Planck-Konstante ℎ
        else:
            italic_map[chr(ord('a') + i)] = chr(0x1D44E + i)
            
        italic_map[chr(ord('A') + i)] = chr(0x1D434 + i)

    italic_map['_'] = '_'

    # 3. Operatoren-Ersetzung
    operator_map = {
        "<=": "≤",
        ">=": "≥",
        "/=": "≠",
        ":=": "←"
    }

    return bold_map, italic_map, operator_map

# Liste aller gültigen Keywords in Kleinbuchstaben ("c" wurde hier ENTFERNT!)
KEYWORDS = {
    "begin", "end", "if", "then", "else", "elif", "fi", "case", "in", "out", "esac",
    "for", "from", "by", "to", "while", "do", "od", "par", "co", "pr", "comment",
    "int", "real", "bool", "char", "format", "string", "bits", "bytes", "void",
    "mode", "op", "prio", "proc", "ref", "sema", "struct", "union", "nest",
    "true", "false", "nil", "abs", "repr", "leng", "short", "upb", "lwb", "print",
    "not", "of", "and", "or"
}

def convert_full_code(code_text, bold_map, italic_map, operator_map):
    token_pattern = re.compile(
        r'(".*?"|\{.*?\}|\bco\b.*?\bco\b|\bcomment\b.*?\bcomment\b|#.*?#|\b\w+\b|:=|<=|>=|/=|\S)', 
        re.DOTALL | re.IGNORECASE | re.UNICODE
    )
    
    custom_modes_and_ops = set()
    
    # Pass 1: Präzise Erkennung von benutzerdefinierten MODEs und OPs.
    tokens_pass1 = token_pattern.findall(code_text)
    for idx, token in enumerate(tokens_pass1):
        if token.lower() in ("mode", "op") and idx + 2 < len(tokens_pass1):
            next_token = tokens_pass1[idx + 1]
            after_next = tokens_pass1[idx + 2]
            if next_token.isalnum() and not next_token.isdigit() and after_next in ("=", ":="):
                custom_modes_and_ops.add(next_token.lower())

    # Pass 2: Eigentliche Konvertierung
    reconstructed = []
    last_idx = 0
    tokens_iter = list(token_pattern.finditer(code_text))
    
    for idx, match in enumerate(tokens_iter):
        reconstructed.append(code_text[last_idx:match.start()])
        t = match.group(0)
        t_lower = t.lower()
        
        # 1. Strings und Kommentare schützen
        if (t.startswith('"') or t.startswith('{') or t.startswith('#') or 
            t_lower.startswith('co') or t_lower.startswith('comment')):
            reconstructed.append(t)
        # 2. Operatoren ersetzen
        elif t in operator_map:
            reconstructed.append(operator_map[t])
        # 3. Alphanumerische Wörter
        elif t.isalnum() and not t.isdigit():
            # Sonderregelung für "c": Es soll NUR fett sein, wenn das vorherige Token "nest" war
            is_nest_c = False
            if t_lower == "c" and idx > 0:
                prev_token = tokens_iter[idx - 1].group(0).lower()
                if prev_token == "nest":
                    is_nest_c = True

            if t_lower in KEYWORDS or t_lower in custom_modes_and_ops or is_nest_c:
                reconstructed.append("".join(bold_map.get(c, c) for c in t_lower))
            else:
                reconstructed.append("".join(italic_map.get(c, c) for c in t))
        else:
            reconstructed.append(t)
        last_idx = match.end()
        
    reconstructed.append(code_text[last_idx:])
    
    # Ergebnis zusammenfügen und ein sauberes, finales Zeilenende garantieren
    final_code = "".join(reconstructed)
    if not final_code.endswith('\n'):
        final_code += '\n'
        
    return final_code

def main():
    parser = argparse.ArgumentParser(
        description="Schritt 0: Migration zu Unicode-Stropping ohne globalen 'c'-Konflikt."
    )
    parser.add_argument(
        "infile", 
        nargs="?", 
        type=argparse.FileType("r", encoding="utf-8"), 
        default=sys.stdin,
        help="Eingabedatei (.a68)."
    )
    parser.add_argument(
        "-o", "--output", 
        type=argparse.FileType("w", encoding="utf-8"), 
        default=sys.stdout,
        help="Ausgabedatei (.u68)."
    )

    args = parser.parse_args()
    bold_map, italic_map, operator_map = build_dynamic_maps()

    try:
        full_content = args.infile.read()
        converted_content = convert_full_code(full_content, bold_map, italic_map, operator_map)
        args.output.write(converted_content)
    except KeyboardInterrupt:
        sys.exit(130)

if __name__ == "__main__":
    main()

