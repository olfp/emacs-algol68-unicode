𝐛𝐞𝐠𝐢𝐧
  # ALGOL 68 Unicode-Stropping Demo File (.u68) #
  # Demonstrates lowercase bold keywords, custom modes, and structures #

  # 1. Custom MODE definition (a structure for a tree node) #
  𝐦𝐨𝐝𝐞 𝐧𝐨𝐝𝐞 = 𝐬𝐭𝐫𝐮𝐜𝐭 (
    𝐢𝐧𝐭 𝑣𝑎𝑙𝑢𝑒,
    𝐫𝐞𝐟 𝐧𝐨𝐝𝐞 𝑙𝑒𝑓𝑡,
    𝐫𝐞𝐟 𝐧𝐨𝐝𝐞 𝑟𝑖𝑔ℎ𝑡
  );

  # 2. Variable declarations using the new mode #
  𝐢𝐧𝐭 𝑛 = 10;
  𝐫𝐞𝐟 𝐧𝐨𝐝𝐞 𝑟𝑜𝑜𝑡 := 𝐧𝐢𝐥;

  # 3. Simple Loop & Array Assignment #
  [𝑛] 𝐢𝐧𝐭 𝑠𝑞𝑢𝑎𝑟𝑒𝑠;
  𝐟𝐨𝐫 𝑖 𝐟𝐫𝐨𝐦 1 𝐭𝐨 𝑛 𝐝𝐨
    𝑠𝑞𝑢𝑎𝑟𝑒𝑠[𝑖] := 𝑖 * 𝑖
  𝐨𝐝;

  # 4. References (Pointer) and Conditional Statement #
  𝐫𝐞𝐟 𝐢𝐧𝐭 𝑟 := 𝑠𝑞𝑢𝑎𝑟𝑒𝑠[5];
  𝐢𝐟 𝑟 > 20 𝐭𝐡𝐞𝐧
    𝑝𝑟𝑖𝑛𝑡 (("Element is large: ", 𝑟, 𝑛𝑒𝑤𝑙𝑖𝑛𝑒))
  𝐞𝐥𝐬𝐞
    𝑝𝑟𝑖𝑛𝑡 (("Element is small: ", 𝑟, 𝑛𝑒𝑤𝑙𝑖𝑛𝑒))
  𝐟𝐢;

  # 5. Procedure (Function) with complex mode manipulation #
  𝐩𝐫𝐨𝐜 𝑚𝑎𝑘𝑒𝑛𝑜𝑑𝑒 = (𝐢𝐧𝐭 𝑣) 𝐫𝐞𝐟 𝐧𝐨𝐝𝐞:
  𝐛𝐞𝐠𝐢𝐧
    𝐫𝐞𝐟 𝐧𝐨𝐝𝐞 𝑛𝑒𝑤 = 𝐡𝐞𝐚𝐩 𝐧𝐨𝐝𝐞; # Allocate node on the heap #
    𝑣𝑎𝑙𝑢𝑒 𝐨𝐟 𝑛𝑒𝑤 := 𝑣;
    𝑙𝑒𝑓𝑡 𝐨𝐟 𝑛𝑒𝑤 := 𝐧𝐢𝐥;
    𝑟𝑖𝑔ℎ𝑡 𝐨𝐟 𝑛𝑒𝑤 := 𝐧𝐢𝐥;
    𝑛𝑒𝑤  # Returns the reference #
  𝐞𝐧𝐝;

  # 6. Using the procedure #
  𝑟𝑜𝑜𝑡 := 𝑚𝑎𝑘𝑒𝑛𝑜𝑑𝑒(42);
  𝑝𝑟𝑖𝑛𝑡 (("Root value: ", 𝑣𝑎𝑙𝑢𝑒 𝐨𝐟 𝑟𝑜𝑜𝑡, 𝑛𝑒𝑤𝑙𝑖𝑛𝑒))

𝐞𝐧𝐝
